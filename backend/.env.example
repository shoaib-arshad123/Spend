# ============================================================================
# EXPENSE TRACKER BACKEND — ENVIRONMENT VARIABLES
# ============================================================================
# LOCAL:      Copy to backend/.env
# PRODUCTION: Set these as environment variables in your hosting dashboard
#             (Render, Railway, etc.) — never commit real values!

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4444
NODE_ENV=development          # Set to "production" on your host

# ── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app  (or wherever you deploy)
FRONTEND_URL=http://localhost:5173

# ── Database (SQL Server / Azure SQL) ───────────────────────────────────────
# Local Windows Auth (no user/password needed):
DB_SERVER=localhost
DB_NAME=expense_tracker
DB_USER=
DB_PASSWORD=
DB_PORT=1433

# Production (SQL Server with credentials):
# DB_SERVER=your-server.database.windows.net
# DB_NAME=expense_tracker
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_PORT=1433

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRY=7d

# ── Email (Nodemailer / Gmail App Password) ──────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to "true" if you want the backend to also serve the built frontend
SERVE_FRONTEND=false
