# ============================================================================
# EXPENSE TRACKER - ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env file to version control!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=your-random-session-secret-key-min-32-chars

# ============================================================================
# DATABASE CONFIGURATION (SQL Server)
# ============================================================================
# Option 1: Windows Authentication (Recommended for local development)
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=expense_tracker
DB_USER=
DB_PASSWORD=

# Option 2: SQL Server Authentication (Uncomment for non-Windows)
# DB_SERVER=your-server-address
# DB_INSTANCE=
# DB_USER=your_username
# DB_PASSWORD=your_password
# DB_PORT=1433

# ============================================================================
# AUTHENTICATION
# ============================================================================
# IMPORTANT: Change this to a secure random string!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ============================================================================
# REDIS CONFIGURATION (Optional - for caching and sessions)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# LOGGING AND MONITORING
# ============================================================================
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@expensetracker.com

# ============================================================================
# FEATURES
# ============================================================================
ENABLE_NOTIFICATIONS=true
ENABLE_REWARDS=true
ENABLE_ANALYTICS=true