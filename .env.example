# Copy to .env for local development (never commit .env with real values)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Supabase setup (Dashboard → SQL Editor — run each file once):
# - supabase/migrations/003_profiles_insert_policy.sql
# - supabase/migrations/004_auto_confirm_signup.sql
# - supabase/migrations/005_confirm_email_rpc.sql   ← required for register/login
# Optional: Auth → Providers → Email → disable "Confirm email"
