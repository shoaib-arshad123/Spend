# Dependency directories
node_modules/
backend/node_modules/

# Environment variables — real secrets, never commit these
.env
.env.local
.env.production
backend/.env
backend/.env.local
backend/.env.production

# .env.example files ARE committed (they contain no real secrets)
!.env.example
!backend/.env.example

# Build outputs
dist/
build/
backend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS Metadata
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testing
coverage/

# Documentation
# (Keep documentation in repo if requested, but some might want to ignore generated ones)
# *.html

# Local database / Temporary files
*.db
*.sqlite
tmp/
temp/
